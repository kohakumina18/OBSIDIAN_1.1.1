ect.text{fill:none;stroke-width:0;}#chatgpt-mermaid-_r_601_ .icon-shape,#chatgpt-mermaid-_r_601_ .image-shape{background-color:rgb(232, 232, 232);text-align:center;}#chatgpt-mermaid-_r_601_ .icon-shape p,#chatgpt-mermaid-_r_601_ .image-shape p{background-color:rgb(232, 232, 232);padding:2px;}#chatgpt-mermaid-_r_601_ .icon-shape .label rect,#chatgpt-mermaid-_r_601_ .image-shape .label rect{opacity:0.5;background-color:rgb(232, 232, 232);fill:rgb(232, 232, 232);}#chatgpt-mermaid-_r_601_ .label-icon{display:inline-block;height:1em;overflow:visible;vertical-align:-0.125em;}#chatgpt-mermaid-_r_601_ .node .label-icon path{fill:currentColor;stroke:revert;stroke-width:revert;}#chatgpt-mermaid-_r_601_ .node .neo-node{stroke:rgb(71, 104, 9);}#chatgpt-mermaid-_r_601_ [data-look=\"neo\"].node rect,#chatgpt-mermaid-_r_601_ [data-look=\"neo\"].cluster rect,#chatgpt-mermaid-_r_601_ [data-look=\"neo\"].node polygon{stroke:url(#chatgpt-mermaid-_r_601_-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#chatgpt-mermaid-_r_601_ [data-look=\"neo\"].swimlane.cluster rect{filter:none;}#chatgpt-mermaid-_r_601_ [data-look=\"neo\"].node path{stroke:url(#chatgpt-mermaid-_r_601_-gradient);stroke-width:1px;}#chatgpt-mermaid-_r_601_ [data-look=\"neo\"].node .outer-path{filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#chatgpt-mermaid-_r_601_ [data-look=\"neo\"].node .neo-line path{stroke:rgb(71, 104, 9);filter:none;}#chatgpt-mermaid-_r_601_ [data-look=\"neo\"].node circle{stroke:url(#chatgpt-mermaid-_r_601_-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#chatgpt-mermaid-_r_601_ [data-look=\"neo\"].node circle .state-start{fill:#000000;}#chatgpt-mermaid-_r_601_ [data-look=\"neo\"].icon-shape .icon{fill:url(#chatgpt-mermaid-_r_601_-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#chatgpt-mermaid-_r_601_ [data-look=\"neo\"].icon-shape .icon-neo path{stroke:url(#chatgpt-mermaid-_r_601_-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#chatgpt-mermaid-_r_601_ .node text{font-size:14px;font-weight:600;letter-spacing:normal;fill:rgb(71, 104, 9);}#chatgpt-mermaid-_r_601_ .edgeLabels text{font-size:13px;font-weight:600;letter-spacing:-0.08px;fill:rgb(71, 104, 9);}#chatgpt-mermaid-_r_601_ .node tspan[font-weight=\"normal\"],#chatgpt-mermaid-_r_601_ .edgeLabels tspan[font-weight=\"normal\"]{font-weight:600;}#chatgpt-mermaid-_r_601_ .edgeLabel .label rect{opacity:1;rx:13px;ry:13px;fill:rgb(232, 232, 232);stroke:rgb(71, 104, 9);stroke-width:1px;}#chatgpt-mermaid-_r_601_ .node rect,#chatgpt-mermaid-_r_601_ .node circle,#chatgpt-mermaid-_r_601_ .node ellipse,#chatgpt-mermaid-_r_601_ .node polygon,#chatgpt-mermaid-_r_601_ .node path{fill:rgb(211, 216, 203);stroke:rgba(0, 0, 0, 0.1);stroke-width:1px;}#chatgpt-mermaid-_r_601_ .node rect{rx:16px;ry:16px;}#chatgpt-mermaid-_r_601_ .node.mermaid-decision .label-container{fill:rgb(232, 232, 232);stroke:rgb(71, 104, 9);stroke-dasharray:2,2;}#chatgpt-mermaid-_r_601_ .edgePaths .flowchart-link{stroke:rgba(6, 57, 87, 0.494);stroke-width:1px;stroke-linecap:round;stroke-linejoin:round;}#chatgpt-mermaid-_r_601_ .marker{fill:rgba(6, 57, 87, 0.494);stroke:rgba(6, 57, 87, 0.494);}#chatgpt-mermaid-_r_601_ :root{--mermaid-font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";}#chatgpt-mermaid-_r_601_ .uncertain rect{fill:rgb(255, 241, 220)!important;stroke:rgb(198, 157, 85)!important;color:rgb(112, 76, 20)!important;}#chatgpt-mermaid-_r_601_ .uncertain polygon{fill:rgb(255, 241, 220)!important;stroke:rgb(198, 157, 85)!important;color:rgb(112, 76, 20)!important;}#chatgpt-mermaid-_r_601_ .uncertain ellipse{fill:rgb(255, 241, 220)!important;stroke:rgb(198, 157, 85)!important;color:rgb(112, 76, 20)!important;}#chatgpt-mermaid-_r_601_ .uncertain circle{fill:rgb(255, 241, 220)!important;stroke:rgb(198, 157, 85)!important;color:rgb(112, 76, 20)!important;}#chatgpt-mermaid-_r_601_ .uncertain path{fill:rgb(255, 241, 220)!important;stroke:rgb(198, 157, 85)!important;color:rgb(112, 76, 20)!important;}#chatgpt-mermaid-_r_601_ .uncertain tspan{fill:rgb(112, 76, 20)!important;}Department / Manager xácđịnh KPIThiết lập cây KPI trên TOPCấu hình tiêu chí cho từngnhân viênCập nhật kết quả đánh giáTổng hợp KPI theo cây phâncấpBáo cáo kết quảSOP / JD / Quy trình thực tếDữ liệu và bằng chứng WorkDoneLiên kết chưa được xác minhNguồn đánh giá chưa rõ\n\nQuy trình được dựng lại từ nội dung thảo luận, không đại diện cho toàn bộ chức năng hiện có của TOP. Đường nét đứt là mối liên hệ cần khảo sát.\n\n### 2.2. Current Systems & Business Artifacts\n\n|Thành phần|Hiện trạng theo thảo luận|Gap|\n|---|---|---|\n|TOP – BSC/KPI|Có cây KPI, phân cấp và tổng hợp kết quả|Chưa kiểm chứng các chức năng quản lý mẫu, dữ liệu, workflow, API|\n|SOP|Có chức năng lưu thông tin trên hệ thống, nhưng cách lưu và sử dụng chưa đồng nhất|Chưa rõ cấu trúc, phiên bản và liên kết KPI|\n|JD|Được nhắc đến như căn cứ mô tả trách nhiệm|Chưa rõ kho lưu, chủ sở hữu và mapping|\n|KPI Definition|Các nhóm có thể khác nhau về cách định nghĩa chỉ tiêu|Chưa có ví dụ đối chiếu thực tế đã xác nhận|\n|Work Done Evidence|Cần có số liệu làm cơ sở đánh giá|Chưa xác định source of truth cho từng loại công việc|\n\nWFX, Jira và DWH là những hệ thống cần xem xét trong bối cảnh PPJ, nhưng transcript chưa xác nhận chúng đang cung cấp dữ liệu trực tiếp cho TOP.\n\n### 2.3. Pain Points & Business Impact\n\n|ID|Pain Point|Business Impact|Mức độ bằng chứng|\n|---|---|---|---|\n|P01|KPI có thể được định nghĩa khác nhau giữa các nhóm cùng chức năng|Khó so sánh hiệu suất và chuẩn hóa việc đánh giá|Ví dụ giả định, cần xác minh|\n|P02|Thiếu cơ sở dữ liệu rõ ràng để giải thích điểm KPI|Khó kiểm chứng, dễ phát sinh đánh giá chủ quan|Được thảo luận|\n|P03|Cấu hình và cập nhật KPI lặp lại theo từng nhân viên|Tốn thời gian, tăng rủi ro sai sót hoặc bỏ sót|Phản ánh trực tiếp|\n|P04|SOP/JD và KPI chưa mapping rõ ràng|Khó chứng minh tiêu chí phản ánh đúng trách nhiệm thực tế|Được thảo luận|\n|P05|Cách đo hiệu quả khác nhau giữa Sales, sản xuất và các bộ phận hỗ trợ|Khó dùng một phương pháp đánh giá đồng nhất|Được thảo luận|\n\nNguồn: các phần thảo luận về sự khác biệt trong KPI, thao tác copy cấu hình và dữ liệu làm cơ sở đánh giá.\n\nPasted text.txt\n\nPasted text.txt\n\nLưu ý: Chưa có dữ liệu định lượng về thời gian xử lý, số trường hợp sai, số KPI thiếu bằng chứng hoặc tỷ lệ đánh giá thiếu nhất quán. Business Impact hiện là rủi ro nghiệp vụ, chưa phải tổn thất đã đo lường.\n\n## 3. TO-BE – Target Business Model\n\n### 3.1. Target Objective\n\nHướng đến mô hình đánh giá mà mỗi kết quả KPI có thể được giải thích bằng trách nhiệm công việc, tiêu chí đo lường, nguồn dữ liệu và kết quả đã được xác nhận.\n\n### TO-BE – Standardized Performance Management\n\n#chatgpt-mermaid-_r_60f_{font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";font-size:16px;fill:rgb(6, 57, 87);}@keyframes edge-animation-frame{from{stroke-dashoffset:0;}}@keyframes dash{to{stroke-dashoffset:0;}}#chatgpt-mermaid-_r_60f_ .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 50s linear infinite;stroke-linecap:round;}#chatgpt-mermaid-_r_60f_ .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 20s linear infinite;stroke-linecap:round;}#chatgpt-mermaid-_r_60f_ .error-icon{fill:rgba(235, 235, 235, 0.96);}#chatgpt-mermaid-_r_60f_ .error-text{fill:rgb(6, 57, 87);stroke:rgb(6, 57, 87);}#chatgpt-mermaid-_r_60f_ .edge-thickness-normal{stroke-width:1px;}#chatgpt-mermaid-_r_60f_ .edge-thickness-thick{stroke-width:3.5px;}#chatgpt-mermaid-_r_60f_ .edge-pattern-solid{stroke-dasharray:0;}#chatgpt-mermaid-_r_60f_ .edge-thickness-invisible{stroke-width:0;fill:none;}#chatgpt-mermaid-_r_60f_ .edge-pattern-dashed{stroke-dasharray:3;}#chatgpt