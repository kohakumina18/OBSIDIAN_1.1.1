.node .outer-path{filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#chatgpt-mermaid-_r_4uj_ [data-look=\"neo\"].node .neo-line path{stroke:rgb(167, 130, 18);filter:none;}#chatgpt-mermaid-_r_4uj_ [data-look=\"neo\"].node circle{stroke:url(#chatgpt-mermaid-_r_4uj_-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#chatgpt-mermaid-_r_4uj_ [data-look=\"neo\"].node circle .state-start{fill:#000000;}#chatgpt-mermaid-_r_4uj_ [data-look=\"neo\"].icon-shape .icon{fill:url(#chatgpt-mermaid-_r_4uj_-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#chatgpt-mermaid-_r_4uj_ [data-look=\"neo\"].icon-shape .icon-neo path{stroke:url(#chatgpt-mermaid-_r_4uj_-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#chatgpt-mermaid-_r_4uj_ .node text{font-size:14px;font-weight:600;letter-spacing:normal;fill:rgb(167, 130, 18);}#chatgpt-mermaid-_r_4uj_ .edgeLabels text{font-size:13px;font-weight:600;letter-spacing:-0.08px;fill:rgb(167, 130, 18);}#chatgpt-mermaid-_r_4uj_ .node tspan[font-weight=\"normal\"],#chatgpt-mermaid-_r_4uj_ .edgeLabels tspan[font-weight=\"normal\"]{font-weight:600;}#chatgpt-mermaid-_r_4uj_ .edgeLabel .label rect{opacity:1;rx:13px;ry:13px;fill:rgb(221, 213, 193);stroke:rgb(167, 130, 18);stroke-width:1px;}#chatgpt-mermaid-_r_4uj_ .node rect,#chatgpt-mermaid-_r_4uj_ .node circle,#chatgpt-mermaid-_r_4uj_ .node ellipse,#chatgpt-mermaid-_r_4uj_ .node polygon,#chatgpt-mermaid-_r_4uj_ .node path{fill:rgb(210, 196, 158);stroke:rgba(0, 0, 0, 0.1);stroke-width:1px;}#chatgpt-mermaid-_r_4uj_ .node rect{rx:16px;ry:16px;}#chatgpt-mermaid-_r_4uj_ .node.mermaid-decision .label-container{fill:rgb(221, 213, 193);stroke:rgb(167, 130, 18);stroke-dasharray:2,2;}#chatgpt-mermaid-_r_4uj_ .edgePaths .flowchart-link{stroke:rgba(43, 92, 109, 0.682);stroke-width:1px;stroke-linecap:round;stroke-linejoin:round;}#chatgpt-mermaid-_r_4uj_ .marker{fill:rgba(43, 92, 109, 0.682);stroke:rgba(43, 92, 109, 0.682);}#chatgpt-mermaid-_r_4uj_ :root{--mermaid-font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";}Finance DashboardFabric Rule EngineRequired DataBusiness SourcesNormalAbnormalClose WarningEstimatedFinalTrace OC Dệt ↔ OC NhuộmEstimate Open OCFinal Closed OCRoot CauseCostsheetConsumptionInventory TransactionOverheadCOGSOC StatusOrder / Produced QtyWFXWarehouseLive DB\n\n---\n\n# 16. Root Cause model ban đầu\n\nWorkshop cho thấy một OC kém hiệu quả có thể có nhiều nguyên nhân và stakeholder muốn hệ thống tự phân tích ra component nào gây variance, thay vì Finance phải tự dò report. Pasted text\n\nTạm thời nên có:\n\n|Root Cause|Detection|\n|---|---|\n|Material Consumption cao|Actual > Standard/Costsheet|\n|Retained Material|Consumption Variance khi Open|\n|Thiếu ghi nhận NPL|Consumption/Issue inconsistency|\n|Processing Cost cao|Actual Processing > Standard|\n|Overhead cao|Actual OVH variance|\n|Thiếu Overhead posting|Expected vs Recorded|\n|Selling Price / GM thấp|Actual GM < threshold|\n|OC chưa Close|Near completion + Status Open|\n|Late posting|Cost xuất hiện sau Close / kỳ sau|\n\n---\n\n# 17. Status model đề xuất cho Dashboard\n\nKhông nên dashboard chỉ có Normal/Abnormal.\n\nNên có ít nhất:\n\n|Status|Ý nghĩa|\n|---|---|\n|`NORMAL_FINAL`|Closed và bình thường|\n|`ABNORMAL_FINAL`|Closed và bất thường|\n|`OPEN_ESTIMATED_NORMAL`|Open, tạm thời bình thường|\n|`OPEN_ESTIMATED_RISK`|Open, dự tính có rủi ro|\n|`CLOSE_WARNING`|Gần đủ Qty nhưng chưa Close|\n|`DATA_INCOMPLETE`|Thiếu dữ liệu để tính|\n|`RECALCULATION_REQUIRED`|Vừa Closed hoặc có update|\n|`REVIEW_REQUIRED`|Rule phát hiện vấn đề cần Finance xem|\n\nĐiều này giải quyết trực tiếp vấn đề hiện tại: hệ thống không được gọi một OC Open là “lời” giống như một OC Closed.\n\n---\n\n# 18. User workflow mục tiêu\n\nHiện Finance đang phải mở nhiều report, copy/paste Excel, thêm công thức rồi dò OC bất thường. Workshop định hướng application phải tự động hóa chính chuỗi thao tác đó để người dùng mở dashboard hằng ngày là biết OC nào cần xử lý và gọi đúng factory/business unit. Pasted text\n\n#chatgpt-mermaid-_r_4ua_{font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";font-size:17px;fill:rgb(43, 92, 109);}@keyframes edge-animation-frame{from{stroke-dashoffset:0;}}@keyframes dash{to{stroke-dashoffset:0;}}#chatgpt-mermaid-_r_4ua_ .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 50s linear infinite;stroke-linecap:round;}#chatgpt-mermaid-_r_4ua_ .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 20s linear infinite;stroke-linecap:round;}#chatgpt-mermaid-_r_4ua_ .error-icon{fill:rgba(230, 224, 209, 0.96);}#chatgpt-mermaid-_r_4ua_ .error-text{fill:rgb(43, 92, 109);stroke:rgb(43, 92, 109);}#chatgpt-mermaid-_r_4ua_ .edge-thickness-normal{stroke-width:1px;}#chatgpt-mermaid-_r_4ua_ .edge-thickness-thick{stroke-width:3.5px;}#chatgpt-mermaid-_r_4ua_ .edge-pattern-solid{stroke-dasharray:0;}#chatgpt-mermaid-_r_4ua_ .edge-thickness-invisible{stroke-width:0;fill:none;}#chatgpt-mermaid-_r_4ua_ .edge-pattern-dashed{stroke-dasharray:3;}#chatgpt-mermaid-_r_4ua_ .edge-pattern-dotted{stroke-dasharray:2;}#chatgpt-mermaid-_r_4ua_ .marker{fill:rgba(43, 92, 109, 0.682);stroke:rgba(43, 92, 109, 0.682);}#chatgpt-mermaid-_r_4ua_ .marker.cross{stroke:rgba(43, 92, 109, 0.682);}#chatgpt-mermaid-_r_4ua_ svg{font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";font-size:17px;}#chatgpt-mermaid-_r_4ua_ p{margin:0;}#chatgpt-mermaid-_r_4ua_ .label{font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";color:rgb(43, 92, 109);}#chatgpt