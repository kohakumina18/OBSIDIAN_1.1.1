		},
		{"id":"fe76eb53197a2faf","type":"file","file":"Pasted image 20261010002940.png","x":7260,"y":37363,"width":909,"height":495},
		{
			"id":"a4f4ceb5c5f2a472",
			"type":"text",
			"text":"# SMART FACTORY",
