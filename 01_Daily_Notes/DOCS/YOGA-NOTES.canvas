y là flow tôi đánh giá rất quan trọng vì nó biến kết quả từ **Estimated → Final**.\n\n#chatgpt-mermaid-_r_503_{font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";font-size:17px;fill:rgb(43, 92, 109);}@keyframes edge-animation-frame{from{stroke-dashoffset:0;}}@keyframes dash{to{stroke-dashoffset:0;}}#chatgpt-mermaid-_r_503_ .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 50s linear infinite;stroke-linecap:round;}#chatgpt-mermaid-_r_503_ .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 20s linear infinite;stroke-linecap:round;}#chatgpt-mermaid-_r_503_ .error-icon{fill:rgba(230, 224, 209, 0.96);}#chatgpt-mermaid-_r_503_ .error-text{fill:rgb(43, 92, 109);stroke:rgb(43, 92, 109);}#chatgpt-mermaid-_r_503_ .edge-thickness-normal{stroke-width:1px;}#chatgpt-mermaid-_r_503_ .edge-thickness-thick{stroke-width:3.5px;}#chatgpt-mermaid-_r_503_ .edge-pattern-solid{stroke-dasharray:0;}#chatgpt-mermaid-_r_503_ .edge-thickness-invisible{stroke-width:0;fill:none;}#chatgpt-mermaid-_r_503_ .edge-pattern-dashed{stroke-dasharray:3;}#chatgpt-mermaid-_r_503_ .edge-pattern-dotted{stroke-dasharray:2;}#chatgpt-mermaid-_r_503_ .marker{fill:rgba(43, 92, 109, 0.682);stroke:rgba(43, 92, 109, 0.682);}#chatgpt-mermaid-_r_503_ .marker.cross{stroke:rgba(43, 92, 109, 0.682);}#chatgpt-mermaid-_r_503_ svg{font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";font-size:17px;}#chatgpt-mermaid-_r_503_ p{margin:0;}#chatgpt-mermaid-_r_503_ .label{font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";color:rgb(43, 92, 109);}#chatgpt-mermaid-_r_503_ .cluster-label text{fill:rgb(43, 92, 1