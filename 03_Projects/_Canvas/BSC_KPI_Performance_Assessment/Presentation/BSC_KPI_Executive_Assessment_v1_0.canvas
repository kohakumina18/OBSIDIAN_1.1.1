		{"id":"n-9fb1c36f9816","type":"text","text":"# 09. Organizational Performance Hierarchy\n\nMember -> Team -> Department -> Division -> Echelon / Corporate\n\nDo not average incompatible percentages. Do not double count contribution.\n\n**PROPOSED / TO VERIFY**","x":80,"y":2600,"width":1020,"height":720,"color":"6"},
