		{"id":"ppj-exec-summary","type":"text","text":"PUR_MaterialAllocation_v1.1.0\n\nDomain:\nSourcing / Purchasing\n\nLifecycle:\nValidation / Stabilization\n\nProgress:\nTBD\n\nGate:\nTransaction reliability and exception control\n\nOutcome:\nValidate controlled reallocation of surplus material across eligible OCs: Material Requirement -> Availability -> Allocation -> Validation -> WFX Transaction.\n\nTop Blocker:\nPartial-allocation correctness\n\nNext Milestone:\nTest multiple OCs and partial allocation\n\nLast Verified:\n2026-09-18","x":0,"y":-90,"width":760,"height":560,"color":"4"},
