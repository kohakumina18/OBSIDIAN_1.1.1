t-mermaid-_r_636_ .edgeLabel p{background-color:rgb(253, 246, 227);}#chatgpt-mermaid-_r_636_ .edgeLabel rect{opacity:0.5;background-color:rgb(253, 246, 227);fill:rgb(253, 246, 227);}#chatgpt-mermaid-_r_636_ .labelBkg{background-color:rgba(253, 246, 227, 0.5);}#chatgpt-mermaid-_r_636_ .cluster rect{fill:rgba(253, 248, 233, 0.96);stroke:rgba(92, 106, 114, 0.08);stroke-width:1px;}#chatgpt-mermaid-_r_636_ .cluster text{fill:rgb(92, 106, 114);}#chatgpt-mermaid-_r_636_ .cluster span{color:rgb(92, 106, 114);}#chatgpt-mermaid-_r_636_ div.mermaidTooltip{position:absolute;text-align:center;max-width:200px;padding:2px;font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";font-size:12px;background:rgba(253, 248, 233, 0.96);border:1px solid rgba(92, 106, 114, 0.08);border-radius:2px;pointer-events:none;z-index:100;}#chatgpt-mermaid-_r_636_ .flowchartTitleText{text-anchor:middle;font-size:18px;fill:rgb(92, 106, 114);}#chatgpt-mermaid-_r_636_ rect.text{fill:none;stroke-width:0;}#chatgpt-mermaid-_r_636_ .icon-shape,#chatgpt-mermaid-_r_636_ .image-shape{background-color:rgb(253, 246, 227);text-align:center;}#chatgpt-mermaid-_r_636_ .icon-shape p,#chatgpt-mermaid-_r_636_ .image-shape p{background-color:rgb(253, 246, 227);padding:2px;}#chatgpt-mermaid-_r_636_ .icon-shape .label rect,#chatgpt-mermaid-_r_636_ .image-shape .label rect{opacity:0.5;background-color:rgb(253, 246, 227);fill:rgb(253, 246, 227);}#chatgpt-mermaid-_r_636_ .label-icon{display:inline-block;height:1em;overflow:visible;vertical-align:-0.125em;}#chatgpt-mermaid-_r_636_ .node .label-icon path{fill:currentColor;stroke:revert;stroke-width:revert;}#chatgpt-mermaid-_r_636_ .node .neo-node{stroke:rgb(147, 178, 89);}#chatgpt-mermaid-_r_636_ [data-look=\"neo\"].node rect,#chatgpt-mermaid-_r_636_ [data-look=\"neo\"].cluster rect,#chatgpt-mermaid-_r_636_ [data-look=\"neo\"].node polygon{stroke:url(#chatgpt-mermaid-_r_636_-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#chatgpt-mermaid-_r_636_ [data-look=\"neo\"].swimlane.cluster rect{filter:none;}#chatgpt-mermaid-_r_636_ [data-look=\"neo\"].node path{stroke:url(#chatgpt-mermaid-_r_636_-gradient);stroke-width:1px;}#chatgpt-mermaid-_r_636_ [data-look=\"neo\"].node .outer-path{filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#chatgpt-mermaid-_r_636_ [data-look=\"neo\"].node .neo-line path{stroke:rgb(147, 178, 89);filter:none;}#chatgpt-mermaid-_r_636_ [data-look=\"neo\"].node circle{stroke:url(#chatgpt-mermaid-_r_636_-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#chatgpt-mermaid-_r_636_ [data-look=\"neo\"].node circle .state-start{fill:#000000;}#chatgpt-mermaid-_r_636_ [data-look=\"neo\"].icon-shape .icon{fill:url(#chatgpt-mermaid-_r_636_-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#chatgpt-mermaid-_r_636_ [data-look=\"neo\"].icon-shape .icon-neo path{stroke:url(#chatgpt-mermaid-_r_636_-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#chatgpt-mermaid-_r_636_ .node text{font-size:14px;font-weight:600;letter-spacing:normal;fill:rgb(147, 178, 89);}#chatgpt-mermaid-_r_636_ .edgeLabels text{font-size:13px;font-weight:600;letter-spacing:-0.08px;fill:rgb(147, 178, 89);}#chatgpt-mermaid-_r_636_ .node tspan[font-weight=\"normal\"],#chatgpt-mermaid-_r_636_ .edgeLabels tspan[font-weight=\"normal\"]{font-weight:600;}#chatgpt-mermaid-_r_636_ .edgeLabel .label rect{opacity:1;rx:13px;ry:13px;fill:rgb(253, 246, 227);stroke:rgb(147, 178, 89);stroke-width:1px;}#chatgpt-mermaid-_r_636_ .node rect,#chatgpt-mermaid-_r_636_ .node circle,#chatgpt-mermaid-_r_636_ .node ellipse,#chatgpt-mermaid-_r_636_ .node polygon,#chatgpt-mermaid-_r_636_ .node path{fill:rgb(239, 237, 209);stroke:rgba(0, 0, 0, 0.1);stroke-width:1px;}#chatgpt-mermaid-_r_636_ .node rect{rx:16px;ry:16px;}#chatgpt-mermaid-_r_636_ .node.mermaid-decision .label-container{fill:rgb(253, 246, 227);stroke:rgb(147, 178, 89);stroke-dasharray:2,2;}#chatgpt-mermaid-_r_636_ .edgePaths .flowchart-link{stroke:rgba(92, 106, 114, 0.494);stroke-width:1px;stroke-linecap:round;stroke-linejoin:round;}#chatgpt-mermaid-_r_636_ .marker{fill:rgba(92, 106, 114, 0.494);stroke:rgba(92, 106, 114, 0.494);}#chatgpt-mermaid-_r_636_ :root{--mermaid-font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";}SợiOC DệtMộc / Greige FabricOC Nhuộm - Màu AOC Nhuộm - Màu BOC Nhuộm - Màu CVải thành phẩm AVải thành phẩm BVải thành phẩm CCustomer OrderCustomer OrderCustomer Order\n\nĐây chính là lý do Fabric cần **production lineage** chứ không chỉ calculation rule.\n\n---\n\n# 5. Logic truy ngược dữ liệu\n\nCOGS report không trực tiếp cung cấp toàn bộ vòng đời Dệt → Nhuộm. COGS chủ yếu ghi nhận OC thành phẩm/Nhuộm khi xuất khách hàng.\n\nDo đó hệ thống phải bắt đầu từ OC Nhuộm rồi truy ngược:\n\n```\nOC Nhuộm\n↓\nFabric / Style / Material Consumption\n↓\nMộc được sử dụng\n↓\nOC Dệt tạo ra Mộc\n↓\nSợi sử dụng\n↓\nChi phí Sợi + Overhead + Processing Dệt\n↓\nCộng với chi phí Nhuộm\n↓\nTotal Fabric Cost\n```\n\nLogic này được mô tả trực tiếp trong workshop: từ COGS của vải thành phẩm phải truy lại OC Dệt, sau đó mới xác định lượng sợi và chi phí sản xuất Mộc. Pasted text\n\n### Sequence đề xuất\n\nData WarehouseInventory TransactionConsumptionCOGS ReportRule EngineData WarehouseInventory TransactionConsumptionCOGS ReportRule Engine#chatgpt-mermaid-_r_62n_{font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";font-size:16px;fill:rgb(92, 106, 114);}@keyframes edge-animation-frame{from{stroke-dashoffset:0;}}@keyframes dash{to{stroke-dashoffset:0;}}#chatgpt-mermaid-_r_62n_ .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 50s linear infinite;stroke-linecap:round;}#chatgpt-mermaid-_r_62n_ .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 20s linear infinite;stroke-linecap:round;}#chatgpt-mermaid-_r_62n_ .error-icon{fill:rgba(253, 248, 233, 0.96);}#chatgpt-mermaid-_r_62n_ .error-text{fill:rgb(92, 106, 114);stroke:rgb(92, 106, 114);}#chatgpt-mermaid-_r_62n_ .edge-thickness-normal{stroke-width:1px;}#chatgpt-mermaid-_r_62n_ .edge-thickness-thick{stroke-width:3.5px;}#chatgpt-mermaid-_r_62n_ .edge-pattern-solid{stroke-dasharray:0;}#chatgpt-mermaid-_r_62n_ .edge-thickness-invisible{stroke-width:0;fill:none;}#chatgpt-mermaid-_r_62n_ .edge-pattern-dashed{stroke-dasharray:3;}#chatgpt-mermaid-_r_62n_ .edge-pattern-dotted{stroke-dasharray:2;}#chatgpt-mermaid-_r_62n_ .marker{fill:rgba(92, 106, 114, 0.494);stroke:rgba(92, 106, 114, 0.494);}#chatgpt-mermaid-_r_62n_ .marker.cross{stroke:rgba(92, 106, 114, 0.494);}#chatgpt-mermaid-_r_62n_ svg{font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";font-size:16px;}#chatgpt-mermaid-_r_62n_ p{margin:0;}#chatgpt-mermaid-_r_62n_ .actor{stroke:rgb(147, 178, 89);fill:rgb(239, 237, 209);stroke-width:1;}#chatgpt-mermaid-_r_62n_ rect.actor.outer-path[data-look=\"neo\"]{filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#chatgpt-mermaid-_r_62n_ rect.note[data-look=\"neo\"]{stroke:rgb(154, 123, 233);fill:rgba(253, 248, 233, 0.96);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#chatgpt-mermaid-_r_62n_ text.actor>tspan{fill:rgb(92, 106, 114);stroke:none;}#chatgpt-mermaid-_r_62n_ .actor-line{stroke:rgba(92, 106, 114, 0.494);}#chatgpt-mermaid-_r_62n_ .innerArc{stroke-width:1.5;stroke-dasharray:none;}#chatgpt-mermaid-_r_62n_ .messageLine0{stroke-width:1.5;stroke-dasharray:none;stroke:rgba(92, 106, 114, 0.494);}#chatgpt-mermaid-_r_62n_ .messageLine1{stroke-width:1.5;stroke-dasharray:2,2;stroke:rgba(92, 106, 114, 0.494);}#chatgpt-mermaid-_r_62n_