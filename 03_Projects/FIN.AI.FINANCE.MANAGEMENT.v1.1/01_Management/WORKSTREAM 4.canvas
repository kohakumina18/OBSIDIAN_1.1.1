ht:600;letter-spacing:normal;fill:rgb(147, 178, 89);}#chatgpt-mermaid-_r_622_ .edgeLabels text{font-size:13px;font-weight:600;letter-spacing:-0.08px;fill:rgb(147, 178, 89);}#chatgpt-mermaid-_r_622_ .node tspan[font-weight=\"normal\"],#chatgpt-mermaid-_r_622_ .edgeLabels tspan[font-weight=\"normal\"]{font-weight:600;}#chatgpt-mermaid-_r_622_ .edgeLabel .label rect{opacity:1;rx:13px;ry:13px;fill:rgb(253, 246, 227);stroke:rgb(147, 178, 89);stroke-width:1px;}#chatgpt-mermaid-_r_622_ .node rect,#chatgpt-mermaid-_r_622_ .node circle,#chatgpt-mermaid-_r_622_ .node ellipse,#chatgpt-mermaid-_r_622_ .node polygon,#chatgpt-mermaid-_r_622_ .node path{fill:rgb(239, 237, 209);stroke:rgba(0, 0, 0, 0.1);stroke-width:1px;}#chatgpt-mermaid-_r_622_ .node rect{rx:16px;ry:16px;}#chatgpt-mermaid-_r_622_ .node.mermaid-decision .label-container{fill:rgb(253, 246, 227);stroke:rgb(147, 178, 89);stroke-dasharray:2,2;}#chatgpt-mermaid-_r_622_ .edgePaths .flowchart-link{stroke:rgba(92, 106, 114, 0.494);stroke-width:1px;stroke-linecap:round;stroke-linejoin:round;}#chatgpt-mermaid-_r_622_ .marker{fill:rgba(92, 106, 114, 0.494);stroke:rgba(92, 106, 114, 0.494);}#chatgpt-mermaid-_r_622_ :root{--mermaid-font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";}Daily SchedulerLấy danh sách OC FabricOC Status?Final AnalysisProvisional AnalysisLoad CostingLoad ConsumptionLoad OverheadLoad COGS / SalesLoad Current CostLoad Consumption VarianceEstimate RemainingMaterial CostEstimated Final CostEstimated GM / EfficiencyNear Completion?WARNING: OC SHOULD BECLOSEDContinue MonitoringApply Fabric RulesNormal / AbnormalRoot Cause AnalysisDaily DashboardClosedOpenYesNo\n\nFlow này đúng với định hướng workshop: chạy hằng ngày, scan cả Open và Closed OC, sử dụng rule/report tương tự Garment; riêng Open OC phải thêm dự toán phần chi phí chưa ghi nhận và cảnh báo. Pasted text\n\n---\n\n# 9. Flow 2 — Event Trigger khi OC được Close\n\nĐây là flow tôi đánh giá rất quan trọng vì nó biến kết quả từ **Estimated → Final**.\n\n#chatgpt-mermaid-_r_61p_{font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";font-size:16px;fill:rgb(92, 106, 114);}@keyframes edge-animation-frame{from{stroke-dashoffset:0;}}@keyframes dash{to{stroke-dashoffset:0;}}#chatgpt-mermaid-_r_61p_ .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 50s linear infinite;stroke-linecap:round;}#chatgpt-mermaid-_r_61p_ .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 20s linear infinite;stroke-linecap:round;}#chatgpt-mermaid-_r_61p_ .error-icon{fill:rgba(253, 248, 233, 0.96);}#chatgpt-mermaid-_r_61p_ .error-text{fill:rgb(92, 106, 114);stroke:rgb(92, 106, 114);}#chatgpt-mermaid-_r_61p_ .edge-thickness-normal{stroke-width:1px;}#chatgpt-mermaid-_r_61p_ .edge-thickness-thick{stroke-width:3.5px;}#chatgpt-mermaid-_r_61p_ .edge-pattern-solid{stroke-dasharray:0;}#chatgpt-mermaid-_r_61p_ .edge-thickness-invisible{stroke-width:0;fill:none;}#chatgpt-mermaid-_r_61p_ .edge-pattern-dashed{stroke-dasharray:3;}#chatgpt-mermaid-_r_61p_ .edge-pattern-dotted{stroke-dasharray:2;}#chatgpt-mermaid-_r_61p_ .marker{fill:rgba(92, 106, 114, 0.494);stroke:rgba(92, 106, 114, 0.494);}#chatgpt-mermaid-_r_61p_ .marker.cross{stroke:rgba(92, 106, 114, 0.494);}#chatgpt-mermaid-_r_61p_ svg{font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";font-size:16px;}#chatgpt-mermaid-_r_61p_ p{margin:0;}#chatgpt-mermaid-_r_61p_ .label{font-family:-apple-system-body,ui-sans-serif,-apple-system,system-ui,\"Segoe UI\",Helvetica,\"Apple Color Emoji\",Arial,sans-serif,\"Segoe UI Emoji\",\"Segoe UI Symbol\";color:rgb(92, 106, 114);}#chatgpt-mermaid-_r_61p