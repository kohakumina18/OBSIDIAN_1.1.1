		{"id":"n-01564e142a1d","type":"text","text":"# 03 Root Cause Analysis\n\nFishbone-style analytical map. Every cause is a hypothesis pending evidence.\n\n**Status labels are part of the content; color is not the only status signal.**","x":0,"y":0,"width":3000,"height":250,"color":"2"},
