		{"id":"tp-hris","type":"text","x":6630,"y":3000,"width":1200,"height":200,"text":"## HRIS\nHuman Resources Information System","color":"#a0522d"},
		{"id":"tp-e-office","type":"text","x":6630,"y":3230,"width":1200,"height":200,"text":"## E-office\nDocuments, workflow, digital signing","color":"#a0522d"},
		{"id":"tp-vnpt-e-invoice","type":"text","x":6630,"y":3460,"width":1200,"height":200,"text":"## VNPT E-Invoice\nElectronic invoice source","color":"#a0522d"},
		{"id":"tp-power-bi","type":"text","x":6630,"y":3690,"width":1200,"height":200,"text":"## Power BI\nReporting / BI","color":"#a0522d"},
		{"id":"tp-iot-wiser-ina","type":"text","x":6630,"y":3920,"width":1200,"height":200,"text":"## IoT / WISER / INA\nMachine and production-line data","color":"#a0522d"},
		{"id":"tp-note","type":"text","x":3990,"y":3000,"width":2520,"height":880,"text":"### On the owner's operating-systems diagram:\n### HRIS, E-office, MMSx, FastReactPlan, Gerber, ShapeShifter\n\n### Confirmed by vault documents, not on the diagram:\n### VNPT E-Invoice, Power BI, GLPI, IoT / WISER / INA\n\nOnly listed applications are drawn. No further vendor application is assumed. E-office: service stopped; reopening needs a fee (vendor re-quoting, BOD 24/09)."},
		{"id":"hdr-grp-wfx","type":"text","x":2580,"y":4380,"width":960,"height":170,"text":"# 01 WFX ERP CORE"},
		{"id":"wfx-style-library","type":"text","x":2650,"y":4570,"width":1350,"height":160,"text":"# ● Style Library","color":"6"},
		{"id":"wfx-budgeting-costing","type":"text","x":2650,"y":4770,"width":1350,"height":160,"text":"# ● Budgeting & Costing","color":"6"},
		{"id":"wfx-bill-of-material","type":"text","x":2650,"y":4970,"width":1350,"height":160,"text":"# ◐ Bill of Material","color":"6"},
		{"id":"wfx-buyer-order-management","type":"text","x":2650,"y":5170,"width":1350,"height":160,"text":"# ● Buyer Order Management","color":"6"},
		{"id":"wfx-brandplm","type":"text","x":2650,"y":5370,"width":1350,"height":160,"text":"# BrandPLM","color":"6"},
		{"id":"wfx-purchase-order-management","type":"text","x":2650,"y":5570,"width":1350,"height":160,"text":"# ● Purchase Order Management","color":"6"},
		{"id":"wfx-inventory-control","type":"text","x":2650,"y":5770,"width":1350,"height":160,"text":"# ● Inventory Control","color":"6"},
