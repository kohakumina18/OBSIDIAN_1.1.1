[Unit]
Description=PPJ Obsidian vault sync every 3 hours and at login (see 03_Projects/_Registry/PPJ_SYNC_DEVICE_REGISTRY.md)

[Timer]
# :20 past every 3rd hour (00,03,06,...,21) so this never lands on the same
# minute as HAKU's or YOGHAAKU's own offset within the fleet's shared grid.
OnCalendar=*-*-* 00/3:20:00
# Two minutes after this user's session starts (boot / login): compare with GitHub and update straight away,
# instead of working on a stale vault until the next 3-hourly slot.
OnStartupSec=2min
# Catch up at next boot/login if the machine was off at a trigger time.
Persistent=true

[Install]
WantedBy=timers.target
