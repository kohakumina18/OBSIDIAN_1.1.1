{
	"nodes":[
		{"id":"title","type":"text","text":"PPJ Portfolio Data Flow - Corrected View\nBusiness source -> curated domain data -> app / automation -> business decision\nRule: AI is an access/orchestration layer, not the source of truth.","x":0,"y":-420,"width":2500,"height":170,"color":"1"},
		{"id":"legend","type":"text","text":"Legend\n- Primary domain owns business logic.\n- Lifecycle/progress are not dataflow.\n- Secondary domains are consumers/tags only.\n- FD != CPD. Wash Portal != Cowash.\n- GLPI is IT support knowledge, not finance/purchasing data.","x":2600,"y":-420,"width":650,"height":210,"color":"6"},
		{"id":"col-source","type":"group","x":0,"y":0,"width":470,"height":2520,"label":"1. BUSINESS SOURCE SYSTEMS","color":"1"},
		{"id":"col-domain-data","type":"group","x":560,"y":0,"width":520,"height":2520,"label":"2. CURATED DOMAIN DATA","color":"3"},
		{"id":"col-apps","type":"group","x":1170,"y":0,"width":820,"height":2520,"label":"3. APPS / AUTOMATIONS","color":"5"},
		{"id":"col-decision","type":"group","x":2080,"y":0,"width":600,"height":2520,"label":"4. BUSINESS DECISIONS / OUTPUTS","color":"2"},
		{"id":"col-ai","type":"group","x":2780,"y":0,"width":620,"height":1040,"label":"AI ACCESS / ORCHESTRATION CONTROL","color":"6"},
		{"id":"src-finance","type":"text","text":"Finance / Accounting Sources\nWFX / ERP, GRN, supplier invoice, e-invoice PDF/XML, finance reports, Excel/DWH extracts.","x":30,"y":60,"width":410,"height":150,"color":"1"},
		{"id":"data-finance","type":"text","text":"Finance Controlled Dataset\nInvoice, GRN, expense, account mapping, reporting definitions, permission rules.\nFinance owns finance logic.","x":590,"y":60,"width":460,"height":170,"color":"3"},
		{"id":"apps-finance","type":"text","text":"[[FIN.AI.FINANCE.MANAGEMENT.v1.1]]\n[[PPJ. Expense-Invoices.v1.1]]\n[[ACC.GRN-SupplierInvoiceBot.v2.3]]\n[[PPJ.Invoice Downloader.v1.2]]\n\nCanonical: FIN, ExpenseInvoices, GRN Bot, InvoiceDownloader","x":1200,"y":45,"width":760,"height":205,"color":"5"},
		{"id":"out-finance","type":"text","text":"Approved outputs\n- Finance report / management insight\n- Invoice processing support\n- GRN exception handling\n- E-invoice download/merge result\nHuman approval before accounting action.","x":2110,"y":50,"width":540,"height":200,"color":"2"},
		{"id":"src-purchasing","type":"text","text":"Sourcing / Purchasing Sources\nSupplier/material master, sample data, fabric/trims lookup, WFX purchasing transaction data, allocation, indent, inventory, GDI.","x":30,"y":360,"width":410,"height":170,"color":"1"},
		{"id":"data-purchasing","type":"text","text":"Two separate data products\n1. Sourcing intelligence: supplier/material/sample/search.\n2. Purchasing transactions: allocation, indent, GDI, inventory.\nDo not mix them.","x":590,"y":350,"width":460,"height":190,"color":"3"},
		{"id":"apps-purchasing","type":"text","text":"[[SCP.SOURCING.CHATBOT.v2.3]]\n[[PUR.Material.Allocation.v1.2]]\n[[PUR.Adhoc Indent mien Nam]]\n[[PUR.Inventory Report]]\n[[PUR.GDI Automation]]\n[[PUR.H&M Label-O Processing]]","x":1200,"y":330,"width":760,"height":225,"color":"5"},
		{"id":"out-purchasing","type":"text","text":"Business actions\n- Sourcing lookup / data governance\n- Allocation review before save/post\n- Indent processing\n- Inventory visibility\n- GDI only after WFX readiness\n- Label-O only after reactivation decision","x":2110,"y":330,"width":540,"height":230,"color":"2"},
		{"id":"src-mer","type":"text","text":"Merchandising Sources\nCustomer requests, costing sheets, Chico's commercial/invoice information, PO/OC/NPL/Packing List, market/e-commerce signals.","x":30,"y":690,"width":410,"height":165,"color":"1"},
		{"id":"data-mer","type":"text","text":"MER Costing / Market Dataset\nCosting logic, quotation inputs, customer-specific rules, product/market signals, PO commitment references.","x":590,"y":690,"width":460,"height":165,"color":"3"},
		{"id":"apps-mer","type":"text","text":"[[PPJ.COSTING.AGENT.PLATFORM.v1.1]]\n[[MER.CHICOS.INVOICE.RECHECK-AUDIT.v1.1]]\n[[E-commerce Market Intelligence v.2.3]]\n[[MER.PO-Commit]]\n\nMER.CHICOS belongs to Merchandising, not Finance.","x":1200,"y":675,"width":760,"height":210,"color":"5"},
		{"id":"out-mer","type":"text","text":"MER decisions\n- Quotation/costing support\n- Chico's audit warning/mismatch report\n- Market opportunity signal\n- PO/customer workflow support\nClosed items stay as historical support, not active build.","x":2110,"y":680,"width":540,"height":220,"color":"2"},
		{"id":"src-prod","type":"text","text":"Production + Wash Sources\nChuyen Treo IoT/line data, Cowash operational wash data, machine/output/delay/rework, wash sampling requests/trials/results.","x":30,"y":1010,"width":410,"height":170,"color":"1"},
		{"id":"data-prod","type":"text","text":"Production / Wash Dataset\nFactory execution data and wash operation data are separate from wash sampling request workflow.","x":590,"y":1015,"width":460,"height":150,"color":"3"},
		{"id":"apps-prod","type":"text","text":"[[PROD.IOT.CHuyenTreo_1]]\n[[PROD.COWASH]]\n[[WASH.SAMPLING.MANAGEMENT.PORTAL.v1.1]]\n\nWash Portal = request/trial/result/approval/history.\nCowash = machine/output/delay/rework.","x":1200,"y":990,"width":760,"height":220,"color":"5"},
		{"id":"out-prod","type":"text","text":"Factory / Wash outputs\n- Line visibility\n- Wash KPI/rescope decision\n- Sampling approval/history\n- Production support dashboard\nDo not merge Wash Portal with Cowash.","x":2110,"y":1000,"width":540,"height":200,"color":"2"},
		{"id":"src-fabric-qc","type":"text","text":"Fabric / Technical / QC Sources\nDirectus FD data, hanger/QR, CPD visual assets, 3D samples, technical docs, BOM/pattern/construction, QSee sample data, RFID trial, NUNOX scans.","x":30,"y":1330,"width":410,"height":200,"color":"1"},
		{"id":"data-fabric-qc","type":"text","text":"Fabric / Technical / QC Datasets\nFD = Fabric + Hanger + QR.\nCPD = 3D + visual assets + image search.\nTD = pattern + BOM + construction + technical docs.\nQC/TQM = inspection/traceability evidence.","x":590,"y":1315,"width":460,"height":240,"color":"3"},
		{"id":"apps-fabric-qc","type":"text","text":"[[FD.Datamart.v2.2]]\n[[CPD.Datamart.v1.1]]\n[[TD.TechnicalPlatform_v2.1]]\n[[PPJxQSee.ai]]\n[[PPJ XPrimo1D RFID Thread]]\n[[PPJxNUNOX]]\n[[PPJxStratova AI]]","x":1200,"y":1310,"width":760,"height":250,"color":"5"},
		{"id":"out-fabric-qc","type":"text","text":"Outputs\n- Fabric/hanger QR visibility\n- 3D visual sample library\n- Technical knowledge/costing reference\n- QC inspection PoC\n- RFID traceability feasibility\n- Hardware/vendor lessons learned","x":2110,"y":1320,"width":540,"height":235,"color":"2"},
		{"id":"src-hr","type":"text","text":"HR Sources\nWISER, HR employee/payroll/BHXH-sensitive data.\nHR data must not be mixed with factory production data.","x":30,"y":1690,"width":410,"height":150,"color":"1"},
		{"id":"data-hr","type":"text","text":"HR Sensitive Dataset\nEmployee, payroll, BHXH and permission-controlled HR fields.\nSeparate governance and access rules.","x":590,"y":1690,"width":460,"height":150,"color":"3"},
		{"id":"apps-hr","type":"text","text":"[[HR.SS&PFD.v1.1]]\n\nCanonical: HR.SSPFD.Workflow.v1.1\nScope requires acronym/source confirmation.","x":1200,"y":1680,"width":760,"height":160,"color":"5"},
		{"id":"out-hr","type":"text","text":"HR outputs\n- HR/BHXH workflow support\n- Protected reporting / mapping\n- No broad AI access unless permission is approved","x":2110,"y":1690,"width":540,"height":150,"color":"2"},
		{"id":"src-learning","type":"text","text":"Portfolio Learning / Collaboration Sources\nUIT partnership, VITAS sharing, AI Automation Workshop, Workshop Analysis, vendor screening history.","x":30,"y":1980,"width":410,"height":160,"color":"6"},
		{"id":"data-learning","type":"text","text":"Portfolio Backlog / Knowledge Base\nIdeas, lessons learned, topic backlog, safe collaboration topics, project opportunities.","x":590,"y":1980,"width":460,"height":150,"color":"6"},
		{"id":"apps-learning","type":"text","text":"[[PPJ.UIT.ACADEMIC.COLLABORATION.v1.1]]\n[[VITAS Sharing]]\n[[AI Automation Workshop]]\n[[Workshop Analysis]]\n\nThese are governance/backlog knowledge, not operational source systems.","x":1200,"y":1960,"width":760,"height":210,"color":"6"},
		{"id":"out-learning","type":"text","text":"Portfolio outputs\n- Safe thesis/prototype topics\n- Workshop follow-up backlog\n- External sharing lessons\n- Vendor screening memory","x":2110,"y":1980,"width":540,"height":175,"color":"6"},
		{"id":"ai-hub","type":"text","text":"[[PPJ.AI.Hub.v2.1]]\nAccess/discovery layer for PPJ AI tools and internal apps.\nNot a data warehouse and not a project merge.","x":2810,"y":70,"width":560,"height":170,"color":"6"},
		{"id":"ai-perri","type":"text","text":"[[PPJ.PERRI.Chatbot]]\nControlled conversational orchestration over approved datasets/tools.\nPermission, logging, fallback required.","x":2810,"y":310,"width":560,"height":170,"color":"6"},
		{"id":"ai-glpi","type":"text","text":"[[PPJ.GLPI-Helpdesk-AI Chatbot]]\nIT/ERP/GLPI support knowledge.\nSeparate from business finance, purchasing, MER and HR datasets.","x":2810,"y":550,"width":560,"height":170,"color":"6"},
		{"id":"ai-rule","type":"text","text":"AI consumption rule\nDomain owner approves data.\nCurated dataset controls mapping.\nAI recommends or assists only.\nBusiness user approves final action.","x":2810,"y":790,"width":560,"height":190,"color":"1"}
	],
