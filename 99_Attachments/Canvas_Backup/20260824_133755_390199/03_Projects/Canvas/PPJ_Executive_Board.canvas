		{"id":"ppj-project-b228516f8b7a4d45","type":"text","x":1690,"y":2425,"width":700,"height":290,"text":"<!-- PPJ_PROJECT_CARD:PROD.COWASH.v2.0 -->\n\n## [[03_Projects/PROD.COWASH|PROD.COWASH.v2.0]]\n\nDomain: Production + Wash\nDelivery Stage: ANALYSIS\nLifecycle: On Hold\nStatus: On Hold\nProgress: TBD\nPriority: Hold\nGate: Owner/data/KPI/access/technical direction\n\nOutcome\n- Preserve the operational wash execution/data initiative pending re-scope.\n\nBoard\n- [[03_Projects/PROD.COWASH/Project_Executive_Board|Local Project Board]]"},
