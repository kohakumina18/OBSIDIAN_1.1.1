		{"id":"562482683c8fc626","type":"text","text":"BAD STEREOTYPE ","x":-1049,"y":1152,"width":250,"height":60},
		{"id":"7022c717064e1e04","type":"text","text":"TEENAGERS \n-> BOTTOM MIDDLE AGE / YOUNG ADULTS \n-> UPPER MIDDLE AGE PEOPLE","x":120,"y":1100,"width":250,"height":135},
		{"id":"14ce10e8f45497b8","type":"text","text":"OVERALL, IT IS CLEAR THAT THE PERCENTAGE OF TEENAGERS TAKING PART IN REGULAR EXERCISE \nSLIGHTLY INCREASE, WHERE AS A STEADY RISE  FROM OTHER AGE GROUPS CAN BE SEEN OVER THE YEARS . \nOVER 15 YEARS, THE NUMBER OF UPPER MIDDLE AGED GROUP / MIDLIFE ADULTS / MATURE ADULTS ACTIVE IN SPORT RECORDS THE BIGGEST GAP.  ","x":-880,"y":1260,"width":250,"height":480},
		{"id":"6e76a0106cc65592","type":"text","text":"- THE PEOPLE WITH THE LOWEST EXERCISE RATE /\n- THE PEOPLE WHO ARE THE LEAST ACTIVE IN SPORT /\n- THE PEOPLE WHO ENJOY EXERCISING LESS THAN OTHERS ","x":-1167,"y":1331,"width":250,"height":269},
		{"id":"ab901c4b9fe4dbb2","type":"text","text":"prior to ....(time)\npreceding ....","x":-1010,"y":988,"width":250,"height":60},
