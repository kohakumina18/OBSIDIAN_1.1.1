		{"id":"d820e2bc071f5628","type":"text","text":"I ENJOY WATCHING TREE SHREDDING LEAVES DURING AUTUMN ","x":16609,"y":13565,"width":250,"height":135},
		{"id":"cf9b1d095ddd7dcf","type":"text","text":"A: WHAT IS YOUR FAVORITE TYPE OF RELAX? \nB: ANSWER + DETAILS + ASK BACK \nA: ANSWER + WHAT KIND OF ... DO YOU LIKE / USUALLY DO \nB: ANSWER + DETAILS + ASK BACK\n","x":16590,"y":13740,"width":490,"height":140},
		{"id":"27e1a54eaceaffff","type":"text","text":"I ENJOY / I LIKE MUSIC FROM THE 90s ","x":16590,"y":13900,"width":353,"height":54},
		{"id":"1c311c89266f9d2d","type":"text","text":"most (adjective) phan lon\n-> mostly (adverb) - theo phan lon","x":17760,"y":13927,"width":301,"height":97},
		{"id":"0aa0cd95727b0ead","type":"text","text":"movies: phim ngan / le\nseries: phim bo / phim dai tap \n","x":16585,"y":13954,"width":315,"height":70},
