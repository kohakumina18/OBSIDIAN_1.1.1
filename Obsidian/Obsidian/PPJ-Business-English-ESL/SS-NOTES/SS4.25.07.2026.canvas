		{"id":"59327a4d450d18af","type":"text","text":"LOVED","x":8841,"y":5005,"width":100,"height":60},
		{"id":"46c7a4ca0573e3a8","type":"text","text":"LISTENED","x":8891,"y":4679,"width":120,"height":60},
		{"id":"20e34b33380bc5bb","type":"text","text":"JOYFUL","x":8900,"y":4763,"width":101,"height":60},
		{"id":"b6f93d891c22f954","type":"text","text":"RELAXED","x":8921,"y":4855,"width":125,"height":60},
